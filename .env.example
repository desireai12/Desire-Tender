# ============================================================
# Desire Tender Intelligence — Environment Configuration
# ============================================================
# Copy this file to apps/api/.env and fill in real values.
# API keys can also be set live via the Settings & Keys tab UI.

# ── LLM Provider (default: gemini) ──────────────────────────
# Options: "gemini" | "openai"
DEFAULT_LLM_PROVIDER=gemini

# ── Google Gemini (Primary) ─────────────────────────────────
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Options: gemini-2.0-flash | gemini-1.5-flash | gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# ── OpenAI (Fallback/Toggle) ────────────────────────────────
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
# Options: gpt-4o | gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# ── Supabase + pgvector ─────────────────────────────────────
# Project settings: https://app.supabase.com → Project Settings → API
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-supabase-project.supabase.co:5432/postgres

# ── Backend Server ───────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change_me_in_production_use_at_least_32_chars_random_string

# ── Frontend ─────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL must point at the running FastAPI server
NEXT_PUBLIC_API_URL=http://localhost:8000
